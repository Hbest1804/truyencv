PORT=5000
SUPABASE_URL=https://your-supabase-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# CORS origin (usually frontend url)
CORS_ORIGIN=http://localhost:5173

JWT_SECRET=your-jwt-secret-here

# Supabase Service Role Key (Supabase Dashboard > Settings > API > service_role)
# Dùng để tự động tạo tài khoản Admin khi backend khởi động
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Thông tin tài khoản Admin mặc định (tự động tạo nếu chưa tồn tại)
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=Admin@123456
ADMIN_USERNAME=Admin
